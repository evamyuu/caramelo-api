# LLM provider (optional). First one set wins. With none, the API runs in deterministic "rules" mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas (optional). Without it, events are kept in memory.
MONGODB_URI=
MONGODB_DATABASE=caramelo
EVENT_TTL_DAYS=90

# Comma-separated origins allowed to call the API (the caramelo-app URL).
CORS_ORIGINS=http://localhost:5173
